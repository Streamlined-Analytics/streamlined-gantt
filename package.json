{
  "name": "streamlined-gantt",
  "version": "0.1.0",
  "description": "Framework-free JavaScript Gantt and construction programme library: working-day calendars, critical path, payment milestones, accessible editing and an event API built for backend integration.",
  "license": "Apache-2.0",
  "author": "Streamlined Analytics Ltd (https://streamlinedanalytics.co.uk)",
  "homepage": "https://github.com/Streamlined-Analytics/streamlined-gantt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Streamlined-Analytics/streamlined-gantt.git"
  },
  "bugs": "https://github.com/Streamlined-Analytics/streamlined-gantt/issues",
  "keywords": [
    "gantt",
    "programme",
    "schedule",
    "critical-path",
    "construction",
    "web-component",
    "htmx"
  ],
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/streamlined-gantt.css",
    "./dist/streamlined-gantt.iife.min.js",
    "./src/element.js"
  ],
  "main": "./dist/streamlined-gantt.js",
  "module": "./dist/streamlined-gantt.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/streamlined-gantt.js"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "default": "./dist/engine.js"
    },
    "./io/mspdi": {
      "types": "./dist/types/io/mspdi.d.ts",
      "default": "./dist/io/mspdi.js"
    },
    "./css": "./dist/streamlined-gantt.css",
    "./dist/*": "./dist/*",
    "./schema/programme.v1.json": "./schema/programme.v1.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "check:banner": "node scripts/check-banner.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:spdx && npm test && npm run build && npm run check:banner && npm run check:size",
    "serve": "node examples/server.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "htmx.org": "2.0.11",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
