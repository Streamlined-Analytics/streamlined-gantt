{
  "name": "streamlined-gantt",
  "version": "0.1.0",
  "description": "Framework-free JavaScript Gantt and construction programme library: working-day calendars, critical path, payment milestones, accessible editing and an event API built for backend integration.",
  "license": "Apache-2.0",
  "author": "Streamlined Analytics Ltd (https://streamlinedanalytics.co.uk)",
  "homepage": "https://github.com/Streamlined-Analytics/streamlined-gantt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Streamlined-Analytics/streamlined-gantt.git"
  },
  "bugs": "https://github.com/Streamlined-Analytics/streamlined-gantt/issues",
  "keywords": [
    "gantt",
    "programme",
    "schedule",
    "critical-path",
    "construction",
    "web-component",
    "htmx"
  ],
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/streamlined-gantt.css",
    "./dist/streamlined-gantt.iife.min.js",
    "./src/element.js"
  ],
  "main": "./dist/streamlined-gantt.js",
  "module": "./dist/streamlined-gantt.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/streamlined-gantt.js"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "default": "./dist/engine.js"
    },
    "./events": {
      "types": "./dist/types/events.d.ts",
      "default": "./dist/events.js"
    },
    "./print": {
      "types": "./dist/types/print/index.d.ts",
      "default": "./dist/print.js"
    },
    "./editor": {
      "types": "./dist/types/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./toolbar": {
      "types": "./dist/types/toolbar.d.ts",
      "default": "./dist/toolbar.js"
    },
    "./health": {
      "types": "./dist/types/health.d.ts",
      "default": "./dist/health.js"
    },
    "./io/csv": {
      "types": "./dist/types/io/csv.d.ts",
      "default": "./dist/io/csv.js"
    },
    "./io/mspdi": {
      "types": "./dist/types/io/mspdi.d.ts",
      "default": "./dist/io/mspdi.js"
    },
    "./css": "./dist/streamlined-gantt.css",
    "./dist/*": "./dist/*",
    "./schema/programme.v1.json": "./schema/programme.v1.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.engine.config.js",
    "test:coverage": "vitest run --config vitest.engine.config.js --coverage",
    "test:e2e": "playwright test",
    "check:banner": "node scripts/check-banner.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:pack": "node scripts/pack-smoke.mjs",
    "test:types": "npm run build:types && tsc -p tests/types/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run check:spdx && npm run test:coverage && npm run build && npm run check:banner && npm run check:size",
    "serve": "node examples/server.mjs",
    "test:dom": "vitest run --project dom",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "test:visual": "docker run --rm --network host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work:Z -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test -c playwright.visual.config.js",
    "test:visual:update": "docker run --rm --network host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work:Z -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test -c playwright.visual.config.js --update-snapshots"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-playwright": "2.12.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "htmx.org": "2.0.11",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "tinybench": "6.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "xmllint-wasm": "5.3.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12"
    }
  }
}
