{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "mutate": [
    "src/engine/**/*.js",
    "src/io/**/*.js",
    "src/model/history.js",
    "src/model/transaction.js",
    "!src/engine/types.js"
  ],
  "reporters": ["clear-text", "progress", "html", "json"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 75
  },
  "incremental": true,
  "incrementalFile": ".stryker-tmp/incremental.json",
  "tempDirName": ".stryker-tmp",
  "concurrency": 4,
  "timeoutMS": 20000,
  "coverageAnalysis": "off",
  "commandRunner": {
    "command": "npx vitest run --config vitest.engine.config.js --bail 1 --reporter dot"
  }
}
